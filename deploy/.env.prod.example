# Copy to deploy/.env.prod and fill in. Never commit the filled file. Generate secrets with:  openssl rand -base64 32
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
REDIS_PASSWORD=
GRAFANA_PASSWORD=

# Public origin of the web app (https). The API refuses to start in production with an http:// origin.
WEB_URL=https://inbox.example.com
PUBLIC_API_URL=https://inbox.example.com

# 32+ random characters / base64 of 32 random bytes. Back up MASTER_KEY separately: without it stored provider tokens cannot be read.
JWT_SECRET=
MASTER_KEY=

# Number of reverse proxies in front of the API (nginx = 1, plus one for a load balancer). Needed for per-client rate limits.
TRUST_PROXY=2

# Prometheus scrape token (16+ characters). Leave empty to disable /api/v1/metrics.
METRICS_TOKEN=

# Optional: images (defaults build locally with docker build -f deploy/api.Dockerfile -t inbox-api . )
# API_IMAGE=ghcr.io/your-org/inbox-api:1.0.0
# WEB_IMAGE=ghcr.io/your-org/inbox-web:1.0.0

# Provider credentials, retention and the rest: see .env.example in the repository root.
