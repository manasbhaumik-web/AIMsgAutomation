# Copy to .env. Never commit real values.
NODE_ENV=development
PORT=3000
WEB_URL=http://localhost:5173

# Runtime connection: non-owner role, subject to row-level security
DATABASE_URL=postgres://inbox_app:inbox_app_dev@localhost:5432/inbox
# Migration/owner connection: used only by `npm run migrate`
DATABASE_ADMIN_URL=postgres://inbox_owner:inbox_owner_dev@localhost:5432/inbox
REDIS_URL=redis://localhost:6379

# 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-change-me-change-me-change-me
# base64 of 32 bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=

# Comma-separated allow-list for OAuth redirect URIs (web callback + mobile deep link)
OIDC_REDIRECT_URIS=http://localhost:5173/auth/callback,inboxai://oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Phase 2: channel connections ---
# Redirects allowed for connecting mailboxes (web default is WEB_URL/connect/callback; add mobile deep links here)
CONNECT_REDIRECT_URIS=inboxai://connect/callback
# Public HTTPS base of this API. Enables provider push; leave empty to rely on polling (local dev).
PUBLIC_API_URL=
# Gmail push via Pub/Sub (optional)
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
# Without REDIS_URL jobs run in-process (development only)
WORKERS_ENABLED=true

# --- Phase 4: chat channels (each is offered only when its credentials are set) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_CONFIG_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# LinkedIn is a profile-only stub: ordinary apps cannot read LinkedIn messages
LINKEDIN_ENABLED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Phase 5: mobile push (optional). Without these, notifications appear in the app only. ---
FCM_PROJECT_ID=
# The Firebase service-account JSON on one line (keep it secret)
FCM_SERVICE_ACCOUNT_JSON=

# --- Phase 6: operations ---
# Reverse proxies in front of the API (nginx = 1). Needed for per-client rate limits behind a proxy.
TRUST_PROXY=0
# Enables GET /api/v1/metrics (Prometheus) behind this bearer token. Leave empty to disable.
METRICS_TOKEN=
# Master-key rotation: put the OLD key here while rotating, then run: npm run rotate-keys -w apps/api
MASTER_KEY_PREVIOUS=
# Retention sweep ages in days (message retention is per tenant, set by the tenant admin)
RETAIN_SESSIONS_DAYS=7
RETAIN_NOTIFICATIONS_DAYS=90
RETAIN_WEBHOOK_INBOX_DAYS=7
RETAIN_DRAFTS_DAYS=30
RETAIN_AUDIT_DAYS=400
RETAIN_USAGE_DAYS=400

