{
  "name": "@inbox/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node --watch dist/main.js",
    "migrate": "tsc -p tsconfig.build.json && node dist/db/cli.js migrate",
    "create-admin": "tsc -p tsconfig.build.json && node dist/db/cli.js create-admin",
    "test": "jest",
    "lint": "eslint src",
    "rotate-keys": "tsc -p tsconfig.build.json && node dist/db/cli.js rotate-keys"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/throttler": "^6.2.0",
    "bullmq": "^6.3.18",
    "helmet": "^7.1.0",
    "jose": "^5.9.0",
    "pg": "^8.12.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.18.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9.9.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "yaml": "^2.9.1"
  },
  "jest": {
    "preset": "ts-jest",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.[tj]s$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "module": "commonjs",
            "esModuleInterop": true,
            "target": "es2022"
          },
          "diagnostics": false
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(htmlparser2|domhandler|domutils|dom-serializer|domelementtype|entities)/)"
    ]
  }
}
